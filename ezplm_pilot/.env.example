# 复制为 .env（本地）或填到 Railway 的 Variables 里
ADMIN_PASSWORD=change-me            # 后台登录密码（HTTP Basic，用户名任意）。公网部署必须设置
DATA_DIR=/data                       # 数据目录（Railway 挂卷到 /data；用 Postgres 时也用来放索引和回写包）
# DATABASE_URL=postgresql://...      # Railway 加 Postgres 插件后自动注入；不设则用 DATA_DIR/staging.sqlite
# 下面这些也可以在网页"设置"里填，环境变量优先
# EZPLM_API_BASE=https://www.ezplm.cn/admin-api
# EZPLM_API_TOKEN=
# ANTHROPIC_API_KEY=
